{
  "name": "webcup-base",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Next.js 15 skeleton for the 24H by Webcup hackathon.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "node scripts/migrate-on-build.mjs && prisma generate && NODE_OPTIONS=--max-old-space-size=768 next build --webpack && npm run build:server && node scripts/publish-server.mjs",
    "build:server": "node scripts/esbuild-server.mjs",
    "start": "node server.cjs",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "email:preview": "email dev --dir emails --port 3030",
    "security:encrypt-at-rest": "tsx --env-file-if-exists=.env scripts/encrypt-at-rest.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "mariadb": "^3.5.4",
    "next": "^16.3.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.63.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.5"
  }
}
