{
  "name": "webcup-base",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Next.js 15 skeleton for the 24H by Webcup hackathon.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "dev:next": "next dev",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=server.cjs --external:next --external:@node-rs/argon2 --external:@prisma/client --external:.prisma --banner:js=\"process.env.NODE_ENV=process.env.NODE_ENV||'production';require('dotenv').config();const{AsyncLocalStorage}=require('node:async_hooks');if(!globalThis.AsyncLocalStorage){globalThis.AsyncLocalStorage=AsyncLocalStorage;}\" --alias:@=./src --alias:@emails=./emails --loader:.node=file",
    "start": "node scripts/start.js",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "email:preview": "email dev --dir emails --port 3030",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-email/components": "^0.5.3",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "resend": "^6.1.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.26",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
