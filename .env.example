# ============================================================================
# Webcup Base — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Database (MySQL) -------------------------------------------------------
# cPanel: create the DB + user, then prefix both with your cPanel account name.
DATABASE_URL="mysql://user:pass@localhost:3306/webcup"
# Set to 1 to log every SQL statement in development.
DATABASE_LOG="0"

# --- Application ------------------------------------------------------------
# Public canonical origin. Used for absolute URLs (emails, OAuth redirects).
NEXT_PUBLIC_APP_URL="https://your-domain.hodi.host"
NODE_ENV="development"
# Port the custom Node server (Next.js + Socket.IO) listens on.
PORT="3000"

# --- BetterAuth -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://your-domain.hodi.host"
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.hodi.host"

# --- OAuth (Google) ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (Resend) ------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="noreply@your-domain.hodi.host"
# When Resend is not configured, emails are logged and (in dev) written to
# `.mail-outbox/` instead of being sent. Handy for the contest.
MAIL_TRANSPORT="resend"

# --- AI (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"
OPENROUTER_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- Uploads ----------------------------------------------------------------
# Absolute path OUTSIDE the app's executable path. Never inside `public/`.
UPLOAD_DIR="/home/user/uploads"
UPLOAD_MAX_BYTES="5242880"

# --- Real-time --------------------------------------------------------------
# `auto` tries WebSockets first and falls back to HTTP polling when the
# reverse proxy strips upgrades. Force with `socket` or `polling`.
NEXT_PUBLIC_REALTIME_MODE="auto"

# --- Security / operations --------------------------------------------------
# Secret header required by /api/cron/* endpoints.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Trust `X-Forwarded-For` for client IP resolution (cPanel/Passenger: 1).
TRUST_PROXY="1"
LOG_LEVEL="info"
