# ============================================================================
# Webcup Base — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Database (MySQL) -------------------------------------------------------
# cPanel: create the DB + user, then prefix both with your cPanel account name.
DATABASE_URL="mysql://user:pass@localhost:3306/webcup"
# Set to 1 to log every SQL statement in development.
DATABASE_LOG="0"

# --- Application ------------------------------------------------------------
# Public canonical origin. Used for absolute URLs (emails, OAuth redirects).
NEXT_PUBLIC_APP_URL="https://your-domain.hodi.host"
NODE_ENV="development"
# Port the custom Node server (Next.js + Socket.IO) listens on.
PORT="3000"

# --- BetterAuth -------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="https://your-domain.hodi.host"
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-domain.hodi.host"

# --- OAuth (Google) ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (Resend) ------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Webcup Base <onboarding@resend.dev>"
# When Resend is not configured, emails are logged and (in dev) written to
# `.mail-outbox/` instead of being sent. Handy for the contest.
MAIL_TRANSPORT="resend"
# Undelivered messages are written here so every auth link stays reachable.
MAIL_OUTBOX_DIR="./.mail-outbox"

# --- AI (generic, OpenAI-compatible) -----------------------------------------
# Works with OpenRouter, xAI, Gemini (OpenAI-compatible endpoints), OpenAI, etc.
# Leave empty to disable the AI assistant — everything else works without it.
#
# Examples:
#   OpenRouter:  AI_BASE_URL="https://openrouter.ai/api/v1"   AI_MODEL="google/gemini-2.0-flash"
#   xAI:         AI_BASE_URL="https://api.x.ai/v1"            AI_MODEL="grok-beta"
#   Gemini:      AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"  AI_MODEL="gemini-2.5-flash"
#   OpenAI:      AI_BASE_URL="https://api.openai.com/v1"      AI_MODEL="gpt-4o-mini"
#
# Backward note: OPENROUTER_API_KEY is still accepted as a fallback if
# AI_API_KEY is not set.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="google/gemini-2.0-flash-exp:free"
AI_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_API_KEY=""   # legacy/ignored if AI_API_KEY is set

# --- Uploads ----------------------------------------------------------------
# Absolute path OUTSIDE the app's executable path. Never inside `public/`.
UPLOAD_DIR="/home/user/uploads"
UPLOAD_MAX_BYTES="5242880"

# --- Real-time --------------------------------------------------------------
# `auto` tries WebSockets first and falls back to HTTP polling when the
# reverse proxy strips upgrades. Force with `socket` or `polling`.
NEXT_PUBLIC_REALTIME_MODE="auto"

# --- Security / operations --------------------------------------------------
# Secret header required by /api/cron/* endpoints.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Trust `X-Forwarded-For` for client IP resolution (cPanel/Passenger: 1).
TRUST_PROXY="1"
LOG_LEVEL="info"
# "ipv4first" (default) keeps outbound requests working on hosts whose IPv6
# route is broken — Node otherwise tries AAAA records first and `fetch` fails.
DNS_RESULT_ORDER="ipv4first"
