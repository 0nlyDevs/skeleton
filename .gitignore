# --- Dependencies -----------------------------------------------------------
node_modules
.pnp
.pnp.js
.yarn

# --- Build output -----------------------------------------------------------
.next
out
build
dist
# Prisma 7 generates its client into the source tree; it is a build product of
# `prisma generate`, which `npm run build` runs before Next compiles.
src/generated
next-env.d.ts
server.cjs
.dev

# --- Environment ------------------------------------------------------------
.env
.env.local
.env*.local
.env.production
.env.development

# --- Secrets / runtime state ------------------------------------------------
# Anchored: these are runtime storage folders at the repo root (UPLOAD_DIR
# default "./uploads"). An unanchored "uploads" also matched source folders
# such as src/modules/uploads/ and silently dropped them from the repo.
/uploads
/.uploads
.mail-outbox

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs

# --- Caches -----------------------------------------------------------------
.cache
.turbo
*.tsbuildinfo
coverage

# --- Editors / OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp

.agents
